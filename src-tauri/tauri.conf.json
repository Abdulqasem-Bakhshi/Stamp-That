{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StampThat!",
  "version": "0.1.0",
  "identifier": "com.StampThat.app",
  "mainBinaryName": "StampThat!",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StampThat!",
        "minWidth": 610,
        "minHeight": 500,
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Abdulqasem Bakhshi",
    "externalBin": ["binaries/StampThat!Backend"],
    "resources": {
      "../backend/dist/StampThat!Backend/_internal/": "_internal/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/windows/header.bmp",
        "sidebarImage": "icons/windows/sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/windows/header.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
